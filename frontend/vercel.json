{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "dist/client/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "^/assets/(.*)", "dest": "/dist/client/assets/$1" },
    { "src": "^/(.+\\.[a-zA-Z0-9]+)$", "dest": "/dist/client/$1" },
    { "src": "/(.*)", "dest": "/server.js" }
  ],
  "env": {
    "NODE_ENV": "production",
    "BASE": "/",
    "VITE_ENV": "production"
  }
}
